# Oyster Pocket backend configuration.
# Copy to backend/.env and fill in. backend/.env is kept out of version control. Never put AI_API_KEY on the device or SD card.

# --- Server ---
OYSTER_BIND_HOST=0.0.0.0
OYSTER_HTTPS_PORT=8443
OYSTER_HTTP_PORT=8000              # plain HTTP, bound to 127.0.0.1 only (CLI, simulator, tests)
OYSTER_DATA_DIR=./data
OYSTER_ADMIN_TOKEN=change-me-to-a-long-random-string
OYSTER_TLS_CERT=./data/dev-ca/server.crt
OYSTER_TLS_KEY=./data/dev-ca/server.key

# --- AI provider (Groq via its OpenAI-compatible API) ---
AI_PROVIDER=groq                   # groq | openai_compatible | fake
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=                          # pick one with: python -m oyster.cli ai-check   (e.g. openai/gpt-oss-120b)
AI_API_KEY=                        # your Groq API key
AI_TIMEOUT_S=60
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1500
AI_PRICE_INPUT_PER_MTOK=           # optional; leave empty -> cost reported as "unavailable"
AI_PRICE_OUTPUT_PER_MTOK=
# Neighbouring Wi-Fi BSSIDs / BLE addresses are sent to the provider masked (aa:bb:cc:xx:xx:xx#ap-1f3a9). Uncomment to send them in full:
# AI_SEND_FULL_IDENTIFIERS=true

# --- Run budgets (enforced in code) ---
RUN_MAX_ACTIONS=12
RUN_MAX_PROVIDER_REQUESTS=6
RUN_MAX_DURATION_S=180
RUN_MAX_CONFIRMATION_WAIT_S=120

# --- AI run rate limits (defaults shown; enforced per device / backend-wide) ---
# RUN_LIMIT_ACTIVE_PER_SESSION=1
# RUN_LIMIT_QUEUED_TOTAL=4
# RUN_LIMIT_PER_DEVICE_HOUR=30

# --- Lab fixture (live BLE GATT server on this PC) ---
LAB_FIXTURE_AUTH_TOKEN=            # 64 hex chars; generate: python -c "import secrets; print(secrets.token_hex(32))"
LAB_FIXTURE_NAME=OysterLab
