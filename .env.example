# Oyster Pocket backend configuration.
# Copy to backend/.env and fill in. backend/.env is kept out of version control. Never put AI_API_KEY on the device or SD card.

# --- Server ---
OYSTER_BIND_HOST=0.0.0.0
OYSTER_HTTPS_PORT=8443
OYSTER_HTTP_PORT=8000              # plain HTTP, bound to 127.0.0.1 only (CLI, simulator, tests)
OYSTER_DATA_DIR=./data
OYSTER_ADMIN_TOKEN=change-me-to-a-long-random-string
OYSTER_TLS_CERT=./data/dev-ca/server.crt
OYSTER_TLS_KEY=./data/dev-ca/server.key

# --- AI provider (Groq via its OpenAI-compatible API) ---
AI_PROVIDER=groq                   # groq | openai_compatible | fake
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=                          # pick one with: python -m oyster.cli ai-check   (e.g. openai/gpt-oss-120b)
AI_API_KEY=                        # your Groq API key
AI_TIMEOUT_S=60
AI_MAX_INPUT_TOKENS=12000   # per-request input cap; set it below your tier (Groq free: 6000 for a 7,000 tokens per minute model)
AI_MAX_CONTEXT_EVENTS=40    # evidence rows offered in each request (16 keeps requests small on a free tier)
AI_MAX_OUTPUT_TOKENS=1500
AI_PRICE_INPUT_PER_MTOK=           # optional; leave empty -> cost reported as "unavailable"
AI_PRICE_OUTPUT_PER_MTOK=
# Voice questions (docs/VOICE_INPUT.md): the device records speech and this model transcribes it. It uses
# AI_API_KEY / AI_BASE_URL above. Leave AI_API_KEY empty and voice "Speak a question" reports it is not set up.
AI_SPEECH_MODEL=whisper-large-v3-turbo   # a speech-to-text model on the provider (empty -> voice disabled)
# AI_SPEECH_LANGUAGE=en              # optional ISO-639-1 hint; empty = the provider auto-detects
# Neighbouring Wi-Fi BSSIDs / BLE addresses are sent to the provider masked (aa:bb:cc:xx:xx:xx#ap-1f3a9). Uncomment to send them in full:
# AI_SEND_FULL_IDENTIFIERS=true

# --- Web access for Oyster AI (docs/WEB_ACCESS.md, ADR-010) ---
# Off by default: nothing is sent to a search provider or a web page unless AI_WEB_ACCESS=on. When on, the
# assistant may call web_search (a redacted query to the search API) and web_fetch (one public page as text) for
# general questions; private, loopback and link-local addresses are refused. The key is never logged.
AI_WEB_ACCESS=off                  # off | on
WEB_SEARCH_PROVIDER=brave          # brave (the only provider in this version)
WEB_SEARCH_API_KEY=                # Brave Search API key; empty -> web_search answers "not_configured"
# WEB_FETCH_MAX_CHARS=6000         # page text handed to the model per web_fetch
# WEB_TIMEOUT_S=8                  # per request (connect + read)
# WEB_MAX_CALLS_PER_RUN=4          # web calls per AI run (each is also one of RUN_MAX_ACTIONS)

# --- Run budgets (enforced in code) ---
RUN_MAX_ACTIONS=12
RUN_MAX_PROVIDER_REQUESTS=6
RUN_MAX_DURATION_S=180
RUN_MAX_CONFIRMATION_WAIT_S=120

# --- AI run rate limits (defaults shown; enforced per device / backend-wide) ---
# RUN_LIMIT_ACTIVE_PER_SESSION=1
# RUN_LIMIT_QUEUED_TOTAL=4
# RUN_LIMIT_PER_DEVICE_HOUR=30

# --- Control Deck executor (docs/CONTROL_DECK.md) ---
# mock records the typed action and executes nothing on any host (the default, also when this line is absent).
# windows acts on THIS PC: media keys, lock, Wake-on-LAN, service status, and service restart (only when the
# backend runs elevated and the service is listed below). Start the backend in your own interactive session for
# media keys and the lock to reach your desktop. An unknown value stops start-up.
OYSTER_DECK_EXECUTOR=mock          # mock | windows
# OYSTER_DECK_LOCAL_HOST_ID=this-pc          # the one host id that means "this PC"
# OYSTER_DECK_WOL_HOSTS=                     # host_id=MAC;host_id=MAC  - the only source of Wake-on-LAN targets
# OYSTER_DECK_WOL_BROADCAST=255.255.255.255  # IPv4 broadcast address for the magic packet (UDP port 9)
# OYSTER_DECK_RESTART_SERVICES=              # comma-separated Windows service names; empty = nothing is ever restarted

# --- Home Assistant bridge for the Smart Home tile (docs/HOME_ASSISTANT.md) ---
# The URL and the token live ONLY here, in backend/.env. They are never sent to the Cardputer, never logged and
# never returned by any API route. Leave them empty and the Smart Home screen says "not set up" (IR still works).
HOME_ASSISTANT_URL=                # e.g. http://<host>:8123 (no credentials, query or fragment); https is verified
HOME_ASSISTANT_TOKEN=              # long-lived access token (Home Assistant profile page > Security)
# HOME_ASSISTANT_CA=               # optional PEM file to trust for an https URL with a private CA
# OYSTER_HOME_ALLOWLIST=           # allowlist JSON; default home_allowlist.json in OYSTER_DATA_DIR; start from examples/home_allowlist.example.json

# --- Lab fixture (live BLE GATT server on this PC) ---
LAB_FIXTURE_AUTH_TOKEN=            # 64 hex chars; generate: python -c "import secrets; print(secrets.token_hex(32))"
LAB_FIXTURE_NAME=OysterLab
