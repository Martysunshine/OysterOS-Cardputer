{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyster-pocket/schemas/run.schema.json",
  "title": "AI run status",
  "description": "Bounded status returned by GET /v1/runs/{id}. Fragments are short; full reports come from the report endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id","session_id","status","question","provider","budget","steps","answer","pending_action","usage","error"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run-[0-9a-zA-Z_-]{1,40}$"},
    "session_id": {"type": "string"},
    "status": {"enum": ["queued","running","awaiting_device","awaiting_local_confirmation","succeeded","failed","cancelled","expired","budget_exhausted","ai_unavailable"]},
    "question": {"type": "string", "maxLength": 1000},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","model","is_fake"],
      "properties": {"name": {"type": "string"}, "model": {"type": ["string","null"]}, "is_fake": {"type": "boolean"}}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions_used","actions_max","provider_requests_used","provider_requests_max","elapsed_s","max_duration_s"],
      "properties": {
        "actions_used": {"type": "integer"}, "actions_max": {"type": "integer"},
        "provider_requests_used": {"type": "integer"}, "provider_requests_max": {"type": "integer"},
        "elapsed_s": {"type": "number"}, "max_duration_s": {"type": "number"}
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index","kind","summary"],
        "properties": {
          "index": {"type": "integer"},
          "kind": {"enum": ["provider_request","tool_call","job","backend_tool","validation_error","final_answer"]},
          "tool": {"type": ["string","null"]},
          "job_id": {"type": ["string","null"]},
          "outcome": {"type": ["string","null"]},
          "event_ids": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string", "maxLength": 240}
        }
      }
    },
    "answer": {
      "type": ["object","null"],
      "additionalProperties": false,
      "properties": {
        "answer_markdown": {"type": "string"},
        "cited_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "suggestions": {"type": "array", "items": {"type": "string"}},
        "source_modes": {"type": "array", "items": {"enum": ["live","offline","simulated"]}},
        "findings": {
          "type": "array",
          "description": "Evaluator findings relevant to this answer (authoritative; the prose is not).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id","test_id","classification","severity"],
            "properties": {
              "finding_id": {"type": "string"},
              "test_id": {"type": "string"},
              "classification": {"enum": ["observation","candidate","confirmed","passed","inconclusive","unsupported"]},
              "severity": {"enum": ["informational","low","medium","high","not_assessed"]}
            }
          }
        },
        "findings_truncated": {"type": "integer", "minimum": 0}
      }
    },
    "pending_action": {
      "type": ["object","null"],
      "additionalProperties": false,
      "properties": {
        "job_id": {"type": "string"}, "operation": {"type": "string"}, "target_id": {"type": ["string","null"]},
        "expected_effect": {"type": "string", "maxLength": 200}, "requires_local_confirmation": {"type": "boolean"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens","output_tokens","cost"],
      "properties": {
        "input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"},
        "cost": {"type": ["number","string"], "description": "Number when pricing is configured, else the string unavailable."}
      }
    },
    "error": {"type": ["string","null"], "maxLength": 500}
  }
}
