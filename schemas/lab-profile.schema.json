{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyster-pocket/schemas/lab-profile.schema.json",
  "title": "Assessment profile",
  "description": "Documented GATT layout, access policy and deterministic assertions for an enrolled target type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "service_uuid", "characteristics", "assertions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string"},
    "profile_version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "service_uuid": {"type": "string", "format": "uuid"},
    "characteristics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uuid", "properties", "policy", "value_format"],
        "properties": {
          "uuid": {"type": "string", "format": "uuid"},
          "properties": {"type": "array", "items": {"enum": ["read", "write", "write_without_response", "notify", "indicate"]}},
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "read": {"enum": ["public", "link_encryption", "link_authentication", "app_authorization", "none"]},
              "write": {"enum": ["public", "link_encryption", "link_authentication", "app_authorization", "none"]},
              "notify": {"enum": ["public", "link_encryption", "link_authentication", "app_authorization", "none"]}
            }
          },
          "value_format": {"type": "string"},
          "max_length": {"type": "integer", "minimum": 1, "maximum": 512},
          "description": {"type": "string"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "characteristic", "operation", "precondition", "expected", "severity_if_violated", "informational"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
          "characteristic": {"type": "string"},
          "operation": {"enum": ["read", "write", "notify", "transfer"]},
          "precondition": {"enum": ["connected_unencrypted", "encrypted", "app_unauthorized", "app_authorized"]},
          "expected": {"enum": ["allowed", "denied"]},
          "severity_if_violated": {"enum": ["informational", "low", "medium", "high"]},
          "informational": {"type": "boolean", "description": "true = result can only ever be an observation, never a finding (e.g. public reads)."},
          "description": {"type": "string"}
        }
      }
    },
    "write_values": {"type": "object"},
    "transfer": {"type": "object"},
    "app_auth": {"type": "object"}
  }
}
