{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyster-pocket/schemas/finding.schema.json",
  "title": "Finding record",
  "description": "Classification is set by deterministic evaluators, never by the model. A public read is informational in every mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","finding_id","session_id","target_id","profile_id","test_id","classification","title","expected_policy","observed_behavior","evidence_ids","severity","confidence","source_mode","limitations","retest_of"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "finding_id": {"type": "string", "pattern": "^finding-[0-9a-zA-Z_-]{1,40}$"},
    "session_id": {"type": "string", "pattern": "^sess-[0-9a-zA-Z_-]{1,40}$"},
    "target_id": {"type": "string"},
    "profile_id": {"type": "string"},
    "test_id": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
    "classification": {"enum": ["observation","candidate","confirmed","passed","inconclusive","unsupported"]},
    "title": {"type": "string", "maxLength": 160},
    "expected_policy": {"type": "string", "maxLength": 400},
    "observed_behavior": {"type": "string", "maxLength": 400},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "severity": {"enum": ["informational","low","medium","high","not_assessed"]},
    "confidence": {"enum": ["low","medium","high"]},
    "source_mode": {"enum": ["live","offline","simulated"]},
    "limitations": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "retest_of": {"type": ["string","null"]}
  }
}
